<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvSubjectName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Physics"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvGrade"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubjectDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Credits: 4 | Marks: 82"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvGrade"
            app:layout_constraintTop_toBottomOf="@+id/tvSubjectName" />

        <TextView
            android:id="@+id/tvTargetHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Swipe left for End Sem targets"
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvSubjectDetails" />

        <!-- Bold Grade Badge -->
        <TextView
            android:id="@+id/tvGrade"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="A+"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/success"
            android:background="@drawable/dialog_background"
            android:backgroundTint="@color/success_soft"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/llActions" />

        <!-- Action Buttons Row -->
        <LinearLayout
            android:id="@+id/llActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvGrade"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnTargetSubject"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="View Targets"
                app:tint="@color/primary" />

            <ImageButton
                android:id="@+id/btnEditSubject"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit Subject"
                app:tint="@color/text_secondary"
                android:layout_marginStart="4dp" />

            <ImageButton
                android:id="@+id/btnDeleteSubject"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete Subject"
                app:tint="@color/danger"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
